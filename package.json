{
  "name": "bilirec-control",
  "version": "1.4.9",
  "private": true,
  "description": "简洁、可靠的录播姬桌面控制工具",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write . --ignore-unknown && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . --ignore-unknown && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint": "npm run format:check && npm run lint:rust",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "changelog": "node scripts/generate-changelog.mjs --auto-from --to HEAD --version main --repository demogest/BiliRecControl --strict",
    "changelog:check": "node scripts/generate-changelog.mjs --auto-from --to HEAD --strict --check",
    "test:updater": "node --test scripts/lib/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-sign",
    "check": "npm run format:check && npm run changelog:check && npm run build && npm run test:updater && npm run test:rust && npm run lint:rust"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "lucide-react": "^1.26.0",
    "next": "^16.2.11",
    "postcss": "^8.5.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "prettier": "^3.9.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  }
}
