{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "BiliRec Control",
  "version": "1.4.9",
  "identifier": "cn.firmant.bilirec-control",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "录播姬控制中心",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "maximized": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFQ0QzQkVCN0IyMDUzMTYKUldRV1V5Qjc2enZOL3JxcGJ0TmpzR3BZSTBsdTluZnFOdVZ5TEx3WTBUQWYzUFBuS2JGUk51UlEK",
      "endpoints": [
        "https://github.com/demogest/BiliRecControl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
